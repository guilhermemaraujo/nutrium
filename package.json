{
  "name": "nutrium-appointment-requests",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/frontend vite.config.ts",
    "lint:fix": "eslint app/frontend vite.config.ts --fix",
    "format": "prettier --write app/frontend vite.config.ts eslint.config.mjs package.json",
    "format:check": "prettier --check app/frontend vite.config.ts eslint.config.mjs package.json",
    "quality": "npm run format:check && npm run lint && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "app/frontend/**/*.css": "prettier --write",
    "eslint.config.mjs": "prettier --write",
    "package.json": "prettier --write"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.0",
    "vite-plugin-ruby": "^5.2.5",
    "vitest": "^5.1.0"
  }
}
